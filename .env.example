# Database: use PostgreSQL for production; SQLite is for local development only.
DATABASE_URL=sqlite:///./pipeline.db
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
APP_BASE_URL=http://localhost:8000

# Select exactly one free-tier provider: gemini or groq
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Alternatively:
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# AI controls
AI_CACHE_TTL=300
AI_RATE_LIMIT_PER_MINUTE=10
AI_MAX_UPLOAD_MB=8
CHROMA_PERSIST_DIR=./chroma_db

# SMTP required for password reset and forgot-user-ID emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
